<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_leave_view_form" model="ir.ui.view">
        <field name="name">Leave Request Customization</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute
                    name="readonly"
                >state in ['cancel', 'refuse', 'validate', 'validate1']</attribute>
                <attribute name="widget">many2one_avatar_user</attribute>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="before">
                <field name="ethiopic_date_from" invisible="1" />
                <field name="ethiopic_date_to" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
