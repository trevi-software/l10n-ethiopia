<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edit_holiday_status_form_02" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.ethiopic</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <data>
                <xpath
                    expr="/form/sheet/div/div[hasclass('oe_title')]/h1/field[@name='name']"
                    position="after"
                >
                    <h1>
                        <field name="ethiopic_name" placeholder="ስም በአማርኛ" />
                    </h1>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_holiday_status_normal_tree_02" model="ir.ui.view">
        <field name="name">hr.leave.type.inherit.ethiopic.tree</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='display_name']" position="after">
                    <field name="ethiopic_name" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="hr_leave_view_tree_02" model="ir.ui.view">
        <field name="name">hr.holidays.view.tree.l10n_et</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="available_leave_days" />
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_form_02" model="ir.ui.view">
        <field name="name">Leave Request l10n_et</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//div[@name='duration_display']" position="after">
                    <label for="return_date_et" string="Return Date (Ethiopic)" />
                    <div>
                        <field
                            name="return_date_et"
                            readonly="state not in ['draft', 'confirm']"
                            invisible="request_unit_half or request_unit_hours"
                            required="not date_from or not date_to"
                        />
                    </div>
                    <div class="o_row">
                        <label for="rest_days" string="Rest" />
                        <div>
                            <field name="rest_days" />
                        </div>
                        <label for="public_holiday_days" string="Holidays" />
                        <div>
                            <field name="public_holiday_days" />
                        </div>
                        <label for="real_days" string="Real" />
                        <div>
                            <field name="real_days" readonly="1" />
                        </div>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
