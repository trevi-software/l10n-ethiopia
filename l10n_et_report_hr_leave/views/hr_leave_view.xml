<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_view_form" model="ir.ui.view">
        <field name="name">Leave Request l10n_et</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='request_date_to']" position="after">
                    <field name="return_date_et" class="oe_inline"
                        attrs="{
                            'readonly': [('state', 'not in', ('draft', 'confirm'))],
                            'invisible': ['|', ('request_unit_half', '=', True), ('request_unit_hours', '=', True)],
                            'required': ['|', ('date_from', '=', False), ('date_to', '=', False)]
                        }"/>
                </xpath>
            </data>
        </field>
    </record>
    
</odoo>
